# Copia este archivo a .env (que nunca se versiona) y cambia los secretos.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
DJANGO_ALLOWED_HOSTS=

# JWT (al menos 32 caracteres)
JWT_SECRET_KEY=cambiar-por-otro-valor-aleatorio-largo

# Llave del HMAC de los CVV. Si cambia, los CVV ya cargados dejan de coincidir.
CVV_HMAC_KEY=cambiar-por-otro-valor-aleatorio-largo

# Base de datos
POSTGRES_DB=coopandina
POSTGRES_USER=coopandina
POSTGRES_PASSWORD=cambiar-clave-local
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Autorizador
UMBRAL_RECHAZO_MODELO=0.85
UMBRAL_ALERTA_MODELO=0.60
TIEMPO_LIMITE_MODELO_MS=300
# Valor fijo de obtener_probabilidad mientras no haya modelo. Súbelo para ver alertas en la demo.
MODELO_PROBABILIDAD_FIJA=0.02

# Saltos de proxy delante de Gunicorn: 1 porque Vite reenvía las peticiones
NUM_PROXIES=1

# Contraseña de los usuarios que crea cargar_datos
CARGA_PASSWORD=cambiar-clave-de-demo
