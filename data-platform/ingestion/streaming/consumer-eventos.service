[Unit]
Description=Consumer de eventos de CoopAndina: Kafka a S3
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/fraud-detection-platform/data-platform/ingestion/streaming
Environment=KAFKA_BOOTSTRAP=172.16.3.113:19092,172.16.3.113:29092,172.16.3.113:39092
Environment=S3_BUCKET=datalake-fraudwatch
ExecStart=/home/ubuntu/streaming-venv/bin/python consumer.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
