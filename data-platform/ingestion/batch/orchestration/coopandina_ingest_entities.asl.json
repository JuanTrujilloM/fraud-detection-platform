{
  "Comment": "Ingesta OLTP desde PostgreSQL hacia la zona Raw en S3",
  "QueryLanguage": "JSONata",
  "StartAt": "IngestAsociados",
  "States": {
    "IngestAsociados": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_etl_coopandina",
        "Arguments": {
          "--target_entity": "asociados",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "IngestComercios"
    },
    "IngestComercios": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_etl_coopandina",
        "Arguments": {
          "--target_entity": "comercios",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "IngestTarjetas"
    },
    "IngestTarjetas": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_etl_coopandina",
        "Arguments": {
          "--target_entity": "tarjetas",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "IngestAutorizaciones"
    },
    "IngestAutorizaciones": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_etl_coopandina",
        "Arguments": {
          "--target_entity": "autorizaciones",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "CuratedAsociados"
    },
    "CuratedAsociados": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_curated_coopandina",
        "Arguments": {
          "--source": "asociados",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "CuratedComercios"
    },
    "CuratedComercios": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_curated_coopandina",
        "Arguments": {
          "--source": "comercios",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "CuratedTarjetas"
    },
    "CuratedTarjetas": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_curated_coopandina",
        "Arguments": {
          "--source": "tarjetas",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "CuratedAutorizaciones"
    },
    "CuratedAutorizaciones": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_curated_coopandina",
        "Arguments": {
          "--source": "autorizaciones",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "CuratedEventos"
    },
    "CuratedEventos": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_curated_coopandina",
        "Arguments": {
          "--source": "eventos",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "CuratedContracargos"
    },
    "CuratedContracargos": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_curated_coopandina",
        "Arguments": {
          "--source": "contracargos",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "DropDimTarjeta"
    },
    "DropDimTarjeta": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "DROP TABLE IF EXISTS coopandina_analytics.dim_tarjeta",
        "WorkGroup": "primary"
      },
      "Next": "CreateDimTarjeta"
    },
    "CreateDimTarjeta": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "{% $replace(\"CREATE TABLE coopandina_analytics.dim_tarjeta WITH ( format = 'PARQUET', external_location = 's3://datalake-fraudwatch/analytics/dim_tarjeta/<run_id>/' ) AS SELECT t.id AS id_tarjeta, t.franquicia, t.estado, a.ciudad AS ciudad_asociado, date_diff('year', a.fecha_nacimiento, current_date) AS edad_asociado, a.ingreso_anual FROM coopandina_curated.tarjetas t JOIN coopandina_curated.asociados a ON a.id = t.asociado_id\", '<run_id>', $states.context.Execution.Name) %}",
        "WorkGroup": "primary"
      },
      "Next": "DropDimComercio"
    },
    "DropDimComercio": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "DROP TABLE IF EXISTS coopandina_analytics.dim_comercio",
        "WorkGroup": "primary"
      },
      "Next": "CreateDimComercio"
    },
    "CreateDimComercio": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "{% $replace(\"CREATE TABLE coopandina_analytics.dim_comercio WITH ( format = 'PARQUET', external_location = 's3://datalake-fraudwatch/analytics/dim_comercio/<run_id>/' ) AS SELECT id AS id_comercio, nombre, categoria, ciudad, vende_en_linea FROM coopandina_curated.comercios\", '<run_id>', $states.context.Execution.Name) %}",
        "WorkGroup": "primary"
      },
      "Next": "DropHechoAutorizacion"
    },
    "DropHechoAutorizacion": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "DROP TABLE IF EXISTS coopandina_analytics.hecho_autorizacion",
        "WorkGroup": "primary"
      },
      "Next": "CreateHechoAutorizacion"
    },
    "CreateHechoAutorizacion": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "{% $replace(\"CREATE TABLE coopandina_analytics.hecho_autorizacion WITH ( format = 'PARQUET', external_location = 's3://datalake-fraudwatch/analytics/hecho_autorizacion/<run_id>/' ) AS SELECT a.id AS id_autorizacion, a.tarjeta_id AS id_tarjeta, a.comercio_id AS id_comercio, a.fecha, year(a.fecha) AS anio, month(a.fecha) AS mes, hour(a.fecha) AS hora, a.monto, a.canal, a.resultado, a.motivo_rechazo, CASE WHEN c.id_autorizacion IS NULL THEN 0 ELSE 1 END AS es_fraude FROM ( SELECT id, tarjeta_id, comercio_id, monto, canal, resultado, motivo_rechazo, CAST(fecha_hora AT TIME ZONE 'America/Bogota' AS timestamp) AS fecha FROM coopandina_curated.autorizaciones ) a LEFT JOIN ( SELECT DISTINCT id_autorizacion FROM coopandina_curated.contracargos WHERE motivo = 'FRAUDE' ) c ON c.id_autorizacion = a.id\", '<run_id>', $states.context.Execution.Name) %}",
        "WorkGroup": "primary"
      },
      "Next": "DropHechoAlerta"
    },
    "DropHechoAlerta": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "DROP TABLE IF EXISTS coopandina_analytics.hecho_alerta",
        "WorkGroup": "primary"
      },
      "Next": "CreateHechoAlerta"
    },
    "CreateHechoAlerta": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "{% $replace(\"CREATE TABLE coopandina_analytics.hecho_alerta WITH ( format = 'PARQUET', external_location = 's3://datalake-fraudwatch/analytics/hecho_alerta/<run_id>/' ) AS SELECT c.id_alerta, c.tipo, c.id_comercio, c.id_tarjeta, c.fecha, year(c.fecha) AS anio, month(c.fecha) AS mes, hour(c.fecha) AS hora, COALESCE(r.estado, 'PENDIENTE') AS estado, date_diff('minute', c.event_time, r.event_time) AS minutos_resolucion FROM ( SELECT id_alerta, tipo, id_comercio, id_tarjeta, event_time, CAST(event_time AT TIME ZONE 'America/Bogota' AS timestamp) AS fecha FROM coopandina_curated.eventos WHERE event_type = 'ALERTA_CREADA' ) c LEFT JOIN ( SELECT id_alerta, estado, event_time FROM coopandina_curated.eventos WHERE event_type = 'ALERTA_RESUELTA' ) r ON r.id_alerta = c.id_alerta\", '<run_id>', $states.context.Execution.Name) %}",
        "WorkGroup": "primary"
      },
      "Next": "QueryCuboAutorizaciones"
    },
    "QueryCuboAutorizaciones": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "SELECT h.anio, h.mes, h.hora, c.categoria, c.ciudad, h.canal, t.franquicia, COUNT(*) AS autorizaciones, SUM(CASE WHEN h.resultado = 'APROBADA' THEN 1 ELSE 0 END) AS aprobadas, SUM(h.es_fraude) AS fraudes, SUM(h.monto) AS monto, SUM(CASE WHEN h.es_fraude = 1 THEN h.monto ELSE 0 END) AS monto_fraude FROM coopandina_analytics.hecho_autorizacion h JOIN coopandina_analytics.dim_comercio c ON c.id_comercio = h.id_comercio JOIN coopandina_analytics.dim_tarjeta t ON t.id_tarjeta = h.id_tarjeta GROUP BY h.anio, h.mes, h.hora, c.categoria, c.ciudad, h.canal, t.franquicia",
        "WorkGroup": "primary"
      },
      "Output": "{% $states.result.QueryExecution.ResultConfiguration.OutputLocation %}",
      "Next": "PublishCuboAutorizaciones"
    },
    "PublishCuboAutorizaciones": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:copyObject",
      "Arguments": {
        "Bucket": "coopandina-olap-web",
        "Key": "data/cubo_autorizaciones.csv",
        "CopySource": "{% $substringAfter($states.input, 's3://') %}"
      },
      "Next": "QueryCuboAlertas"
    },
    "QueryCuboAlertas": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Arguments": {
        "QueryString": "SELECT h.anio, h.mes, h.tipo, h.estado, c.categoria, COUNT(*) AS alertas, COALESCE(SUM(h.minutos_resolucion), 0) AS minutos_resolucion FROM coopandina_analytics.hecho_alerta h JOIN coopandina_analytics.dim_comercio c ON c.id_comercio = h.id_comercio GROUP BY h.anio, h.mes, h.tipo, h.estado, c.categoria",
        "WorkGroup": "primary"
      },
      "Output": "{% $states.result.QueryExecution.ResultConfiguration.OutputLocation %}",
      "Next": "PublishCuboAlertas"
    },
    "PublishCuboAlertas": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:copyObject",
      "Arguments": {
        "Bucket": "coopandina-olap-web",
        "Key": "data/cubo_alertas.csv",
        "CopySource": "{% $substringAfter($states.input, 's3://') %}"
      },
      "End": true
    }
  }
}
